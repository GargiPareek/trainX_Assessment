NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ums_payments?replicaSet=rs0&retryWrites=true&w=majority
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2026-01-01
CASHFREE_CLIENT_ID=your_sandbox_client_id
CASHFREE_CLIENT_SECRET=your_sandbox_client_secret
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_SESSION_ENCRYPTION_KEY=base64:replace-with-32-byte-base64-key
PUBLIC_API_URL=https://your-public-https-host.example.com
FRONTEND_RETURN_URL=https://your-frontend.example.com/payment/return
# Optional: set both ERP_PAYMENT_WEBHOOK_URL (HTTPS) and ERP_PAYMENT_WEBHOOK_SECRET to enable outbox delivery.